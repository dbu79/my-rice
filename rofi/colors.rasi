* {
    background:                  #1a1110;
    foreground:                  #f1dedc;

    primary:                     #ffb4a9;
    on-primary:                  #561e17;
    primary-fixed:                #ffdad5;
    on-primary-fixed-trans:       #ffb4a9CC;

    secondary:                   #e7bdb7;
    on-secondary:                #442926;
    secondary-container:         #5d3f3b;

    tertiary:                    #dec38c;
    on-tertiary:                 #3e2e04;

    surface:                     #1a1110;
    surface-variant:             #534341;
    on-surface:                  #f1dedc;

    outline:                     #a08c89;
    error:                       #ffb4ab;

    accent:                      #dec38c;
}