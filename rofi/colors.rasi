* {
    background:                  #0f1512;
    foreground:                  #dee4df;

    primary:                     #89d6b9;
    on-primary:                  #00382a;
    primary-fixed:                #a4f2d5;
    on-primary-fixed-trans:       #89d6b9CC;

    secondary:                   #b2ccc0;
    on-secondary:                #1e352c;
    secondary-container:         #344c42;

    tertiary:                    #a7cce1;
    on-tertiary:                 #0b3445;

    surface:                     #0f1512;
    surface-variant:             #404944;
    on-surface:                  #dee4df;

    outline:                     #89938e;
    error:                       #ffb4ab;

    accent:                      #a7cce1;
} 