@theme "/dev/null"
@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";

    background-color: transparent;
    text-color: @foreground;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

configuration {
    terminal: "kitty"; 
}

window {
    location: north;
    y-offset: calc(50% - 176px);
    width: 480;
    border-radius: 10px;

    background-color: @background;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @surface-variant;
    border-color: @outline;

    border: 2px;
    border-radius: 10px;

    padding: 8px 16px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @primary;
}

entry {
    placeholder: "Search";
    placeholder-color: @outline;
    text-color: @foreground;
}

message {
    margin: 12px 0 0;

    border: 2px;
    border-radius: 10px;
    border-color: @outline;

    background-color: @surface;
    text-color: @foreground;
}

textbox {
    padding: 8px 24px;
    background-color: inherit;
    text-color: inherit;
}

listview {
    background-color: transparent;

    margin: 12px 0 0;
    lines: 8;
    columns: 1;

    fixed-height: false;
}

element {
    padding: 8px 16px;
    spacing: 8px;
    border-radius: 10px;

    background-color: transparent;
    text-color: @foreground;
}

element normal active {
    text-color: @secondary;
}

element alternate active {
    text-color: @secondary;
}

element selected.normal,
element selected.active {
    background-color: @primary;
    text-color: @on-primary;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;

}