* {
    background:                  #1a120e;
    foreground:                  #f0dfd8;

    primary:                     #ffb693;
    on-primary:                  #542104;
    primary-fixed:                #ffdbcc;
    on-primary-fixed-trans:       #ffb693CC;

    secondary:                   #e6beac;
    on-secondary:                #432a1e;
    secondary-container:         #5c4033;

    tertiary:                    #d1c88f;
    on-tertiary:                 #363107;

    surface:                     #1a120e;
    surface-variant:             #52443d;
