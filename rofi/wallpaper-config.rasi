@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    accent: @primary;
}

window {
    width: 60%;
    height: 420px;
    background-color: @background;
    border: 2px;
    border-radius: 12px;
    padding: 20px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 20px;
}

inputbar {
    enabled: true;
    background-color: @surface;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 2px;

}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search wallpapers...";
    text-color: @on-surface;
}

listview {
    columns: 4;
    lines: 1;
    fixed-height: false;
    spacing: 16px;
    padding: 4px;
}

element {
    orientation: vertical;
    border-radius: 10px;
    padding: 6px;
    border: 3px;
    border-color: transparent;
    spacing: 8px;
}

element selected {
    background-color: @on-primary-fixed-trans;
}

element-icon {
    size: 220px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 6px;
}

element-text {
    enabled: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: @on-surface;
}